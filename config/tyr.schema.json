{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tyr configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "upstreams",
    "pools"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8787
        },
        "maxRequestBodyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "upstreams": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "anthropic": {
          "$ref": "#/$defs/upstream"
        },
        "openai": {
          "$ref": "#/$defs/upstream"
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "responseHeadersMs": {
          "type": "integer",
          "minimum": 0
        },
        "streamIdleMs": {
          "type": "integer",
          "minimum": 0
        },
        "clientStallMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustHeader": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pool"
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drainTimeoutMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url",
        "instanceId"
      ],
      "properties": {
        "type": {
          "const": "latchflo"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "pools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bootstrapTokenEnv": {
          "type": "string",
          "minLength": 1,
          "default": "LATCHFLO_AGENT_BOOTSTRAP_TOKEN"
        },
        "agentTokenFile": {
          "type": "string",
          "minLength": 1
        },
        "retryIntervalMs": {
          "type": "integer",
          "minimum": 100,
          "default": 1000,
          "description": "Base retry delay for startup and transient control-plane calls. Tyr applies bounded exponential backoff with jitter."
        },
        "retryMaxIntervalMs": {
          "type": "integer",
          "minimum": 100,
          "default": 30000,
          "description": "Maximum client-generated retry delay for transient control-plane failures."
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "default": 5000,
          "description": "Deadline for each Latchflo control-plane request."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "zone": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jwt"
      ],
      "properties": {
        "jwt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jwksUrl",
            "issuer",
            "audience"
          ],
          "properties": {
            "jwksUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "audience": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "header": {
              "type": "string",
              "minLength": 1,
              "default": "x-tyr-identity-token",
              "not": {
                "enum": [
                  "authorization",
                  "content-type",
                  "x-api-key",
                  "anthropic-version",
                  "anthropic-beta",
                  "openai-organization",
                  "openai-project"
                ]
              }
            },
            "algorithms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "RS256",
                  "RS384",
                  "RS512"
                ]
              },
              "default": [
                "RS256"
              ]
            },
            "cacheTtlMs": {
              "type": "integer",
              "minimum": 0,
              "default": 300000
            },
            "requestTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 5000
            },
            "clockSkewSeconds": {
              "type": "integer",
              "minimum": 0,
              "default": 30
            },
            "requireExpiration": {
              "type": "boolean",
              "default": true
            },
            "claims": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "default": "sub"
                },
                "tenantId": {
                  "type": "string",
                  "minLength": 1,
                  "default": "tenant_id"
                },
                "applicationId": {
                  "type": "string",
                  "minLength": 1,
                  "default": "azp"
                },
                "roles": {
                  "type": "string",
                  "minLength": 1,
                  "default": "roles"
                }
              }
            }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "invoke": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "operator": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "highPriority": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capacityAware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instanceId",
            "sharedSecretEnv",
            "peers"
          ],
          "properties": {
            "instanceId": {
              "type": "string",
              "minLength": 1
            },
            "sharedSecretEnv": {
              "type": "string",
              "minLength": 1
            },
            "pollIntervalMs": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "staleAfterMs": {
              "type": "integer",
              "minimum": 1,
              "default": 1000
            },
            "probeTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 250
            },
            "forwardTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            },
            "peers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "baseUrl"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseUrl": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "modelPrefixes",
        "estimatorModel",
        "maxConcurrent"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "modelPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "estimatorModel": {
          "type": "string",
          "minLength": 1
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 0
        },
        "maxQueue": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "queueTimeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "limitsRevision": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "inFlightTokenBudget": {
          "type": "integer",
          "minimum": 0
        },
        "highPriorityTokenReserve": {
          "type": "integer",
          "minimum": 0
        },
        "defaultOutputReservation": {
          "type": "integer",
          "minimum": 0
        },
        "opaqueMediaInputTokenReservation": {
          "type": "integer",
          "minimum": 0,
          "default": 2048
        },
        "admissionMode": {
          "type": "string",
          "enum": [
            "enforce",
            "observe"
          ],
          "default": "enforce"
        },
        "adaptiveEstimation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "smoothing": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "default": 0.2
            },
            "minSamples": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            },
            "minCorrection": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.5
            },
            "maxCorrection": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 2
            },
            "maxModels": {
              "type": "integer",
              "minimum": 1,
              "default": 64
            }
          }
        }
      }
    }
  }
}
