{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tyr configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "upstreams",
    "pools"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8787
        },
        "maxRequestBodyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "upstreams": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "anthropic": {
          "$ref": "#/$defs/upstream"
        },
        "openai": {
          "$ref": "#/$defs/upstream"
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "responseHeadersMs": {
          "type": "integer",
          "minimum": 0
        },
        "streamIdleMs": {
          "type": "integer",
          "minimum": 0
        },
        "clientStallMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustHeader": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pool"
      }
    }
  },
  "$defs": {
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "modelPrefixes",
        "estimatorModel",
        "maxConcurrent"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "modelPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "estimatorModel": {
          "type": "string",
          "minLength": 1
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1
        },
        "inFlightTokenBudget": {
          "type": "integer",
          "minimum": 0
        },
        "highPriorityTokenReserve": {
          "type": "integer",
          "minimum": 0
        },
        "defaultOutputReservation": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
