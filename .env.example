# Anthropic-shaped upstream base URL — powers POST /v1/messages.
# Omit (leave unset) to disable that route.
UPSTREAM_URL=https://api.anthropic.com

# OpenAI-shaped upstream base URL — powers POST /v1/chat/completions.
# Omit (leave unset) to disable that route.
OPENAI_UPSTREAM_URL=https://api.openai.com

# Timeout (ms) for upstream fetch requests. Combined with the
# client-disconnect abort signal — whichever fires first aborts the
# upstream call. Omit (leave unset) for no timeout.
UPSTREAM_TIMEOUT_MS=

# Maximum number of bytes buffered from an incoming request body before
# it is rejected with 413 Payload Too Large. Guards against unbounded
# memory growth from oversized or malicious payloads.
# Omit (leave unset) to use the default of 1048576 (1 MiB).
MAX_REQUEST_BODY_BYTES=

# Listen port
PORT=8787


# Default pool tuning (see src/index.ts)
MAX_CONCURRENT=50
TOKEN_BUDGET=500000
HIGH_PRIORITY_RESERVE=0
