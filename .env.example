# Anthropic-shaped upstream base URL — powers POST /v1/messages.
# Omit (leave unset) to disable that route.
UPSTREAM_URL=https://api.anthropic.com

# OpenAI-shaped upstream base URL — powers POST /v1/chat/completions.
# Omit (leave unset) to disable that route.
OPENAI_UPSTREAM_URL=https://api.openai.com

# Timeout (ms) for the upstream to send response headers (i.e. for the
# fetch() call to resolve). Guards against an upstream that never responds
# at all. Cancelled the instant headers arrive — has no effect on how long
# a streaming body may subsequently run. Combined with the client-disconnect
# abort signal — whichever fires first aborts the upstream call.
# Omit (leave unset) for no response timeout.
RESPONSE_TIMEOUT_MS=

# Timeout (ms) for the gap between consecutive chunks of a streaming
# upstream response body. Guards against a stream that starts fine but then
# stalls mid-flight. Resets on every chunk received, so a healthy
# long-running stream that keeps sending data is never killed by this,
# regardless of its total duration. Only applies to streaming responses.
# Omit (leave unset) for no idle timeout.
IDLE_TIMEOUT_MS=


# Maximum number of bytes buffered from an incoming request body before
# it is rejected with 413 Payload Too Large. Guards against unbounded
# memory growth from oversized or malicious payloads.
# Omit (leave unset) to use the default of 1048576 (1 MiB).
MAX_REQUEST_BODY_BYTES=

# Listen port
PORT=8787


# Default pool tuning (see src/index.ts)
MAX_CONCURRENT=50
TOKEN_BUDGET=500000
HIGH_PRIORITY_RESERVE=0
