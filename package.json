{
  "name": "tyr-admission-controller",
  "version": "0.32.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Tyr is a capacity guard for LLM traffic that reserves expected token capacity before execution, sheds requests that would overcommit a model pool, and reconciles reservations from live provider usage.",
  "homepage": "https://github.com/mofluxhq/tyr-admission-controller#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mofluxhq/tyr-admission-controller.git"
  },
  "bugs": {
    "url": "https://github.com/mofluxhq/tyr-admission-controller/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "prevalidate:config": "npm run build",
    "validate:config": "node dist/cli.js validate",
    "prepack": "npm run build",
    "smoke": "node --input-type=module -e \"await import('./dist/server.js'); await import('./dist/adapters.js');\"",
    "release:check": "npm run verify:vendor && npm run lint && npm run typecheck && npm test && npm run verify:admission-provenance && npm run verify:admission-timing && npm run verify:routing && npm run verify:routing-topology && npm run verify:openai-responses && npm run verify:admission-classes && npm run verify:borrowed-restoration && npm run verify:demand && npm run verify:handoff && npm run verify:class-handoff && npm run verify:progressive && npm run smoke && npm pack --dry-run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "demo:up": "docker compose -f demo/compose.metrics.yaml up --build",
    "demo:down": "docker compose -f demo/compose.metrics.yaml down",
    "demo:normal": "node demo/load.mjs --requests 12 --concurrency 2",
    "demo:overload": "node demo/load.mjs --requests 100 --concurrency 25",
    "smoke:telemetry": "npm run build && node scripts/telemetry-smoke.mjs",
    "verify:routing": "npm run build && node scripts/verify-capacity-routing.mjs",
    "verify:demand": "npm run build && node scripts/verify-demand-reporting.mjs",
    "verify:progressive": "npm run build && node scripts/verify-progressive-reconciliation.mjs",
    "verify:admission-classes": "npm run build && node scripts/verify-admission-classes.mjs",
    "verify:borrowed-restoration": "npm run build && node scripts/verify-borrowed-restoration.mjs",
    "verify:handoff": "npm run build && node scripts/verify-capacity-handoff.mjs",
    "verify:class-handoff": "npm run build && node scripts/verify-class-handoff.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "verify:vendor-provenance": "node scripts/verify-vendor-provenance.mjs",
    "verify:admission-provenance": "npm run build && node scripts/verify-admission-provenance.mjs",
    "verify:admission-timing": "npm run build && node scripts/verify-admission-timing.mjs",
    "verify:routing-topology": "npm run build && node scripts/verify-dynamic-routing-topology.mjs",
    "verify:openai-responses": "npm run build && node scripts/verify-openai-responses.mjs"
  },
  "dependencies": {
    "async-bulkhead-llm": "3.17.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.0"
  },
  "bin": {
    "tyr": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config/tyr.example.yaml",
    "config/tyr.latchflo.example.yaml",
    "config/tyr.schema.json",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.txt",
    "NOTICE.txt"
  ]
}
