{
  "name": "tyr-admission-controller",
  "version": "0.11.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "description": "Tyr is a capacity guard for LLM traffic that reserves expected token capacity before execution, sheds requests that would overcommit a model pool, and reconciles reservations from live provider usage.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "prevalidate:config": "npm run build",
    "validate:config": "node dist/cli.js validate",
    "prepack": "npm run build",
    "smoke": "node --input-type=module -e \"await import('./dist/server.js'); await import('./dist/adapters.js');\"",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm pack --dry-run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "async-bulkhead-llm": "3.11.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.0"
  },
  "bin": {
    "tyr": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config/tyr.example.yaml",
    "config/tyr.schema.json",
    "README.md"
  ]
}
